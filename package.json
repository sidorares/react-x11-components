{
  "name": "@react-x11/components",
  "version": "0.1.0",
  "description": "Components for react-x11 that do not belong in the core package",
  "keywords": [
    "react",
    "react-x11",
    "x11",
    "components",
    "widgets",
    "desktop",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidorares/react-x11-components.git"
  },
  "author": "Andrey Sidorov <andrey.sidorov@gmail.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./calendar": {
      "types": "./dist/calendar/index.d.ts",
      "default": "./dist/calendar/index.js"
    },
    "./code-editor": {
      "types": "./dist/code-editor/index.d.ts",
      "default": "./dist/code-editor/index.js"
    },
    "./desktop-calendar": {
      "types": "./dist/desktop-calendar/index.d.ts",
      "default": "./dist/desktop-calendar/index.js"
    },
    "./sparkline": {
      "types": "./dist/sparkline/index.d.ts",
      "default": "./dist/sparkline/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "pretypecheck": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "tsx scripts/check-package.ts",
    "examples:calendar": "tsx examples/calendar.tsx",
    "examples:code-editor": "tsx examples/code-editor.tsx",
    "examples:sparkline": "tsx examples/sparkline.tsx",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@lezer/highlight": "^1.0.0",
    "react": "^19.0.0",
    "react-x11": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@lezer/highlight": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "esbuild": "^0.28.1",
    "eslint": "^9.32.0",
    "globals": "^17.8.0",
    "prettier": "^3.6.0",
    "react": "^19.2.8",
    "react-x11": "github:sidorares/react-x11#master",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "ical.js": "^2.2.1"
  }
}
