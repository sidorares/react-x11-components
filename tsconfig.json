{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "jsxImportSource": "react-x11",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": [],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.d.ts", "test/types/**/*.tsx", "test/types/**/*.ts"]
}
